{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Idle Civ: Start Dev Server",
      "type": "shell",
      "dependsOn": ["Idle Civ: Build"],
      "dependsOrder": "sequence",
      "command": "${workspaceFolder}\\tools\\node\\npm.cmd",
      "args": ["run", "dev", "--", "--host", "127.0.0.1"],
      "options": {
        "env": {
          "PATH": "${workspaceFolder}\\tools\\node;${env:PATH}"
        }
      },
      "isBackground": true,
      "runOptions": {
        "instanceLimit": 1
      },
      "problemMatcher": {
        "owner": "vite",
        "pattern": {
          "regexp": ".*"
        },
        "background": {
          "beginsPattern": ".*",
          "endsPattern": "http://127\\.0\\.0\\.1:5173/"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false
      }
    },
    {
      "label": "Idle Civ: Stop Vite",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        "$connections = @(Get-NetTCPConnection -LocalPort 5173 -State Listen -ErrorAction SilentlyContinue); foreach ($connection in $connections) { Stop-Process -Id $connection.OwningProcess -Force -ErrorAction SilentlyContinue }"
      ],
      "problemMatcher": []
    },
    {
      "label": "Idle Civ: Build",
      "type": "shell",
      "command": "${workspaceFolder}\\tools\\node\\npm.cmd",
      "args": ["run", "build"],
      "options": {
        "env": {
          "PATH": "${workspaceFolder}\\tools\\node;${env:PATH}"
        }
      },
      "problemMatcher": "$tsc",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Idle Civ: Simulate Battle",
      "type": "shell",
      "command": "${workspaceFolder}\\tools\\node\\node.exe",
      "args": [
        "temp/min-army.mjs",
        "${input:battleNumber}",
        "${input:excludedUnits}"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Idle Civ: Run Simulation Debug",
      "type": "shell",
      "command": "${workspaceFolder}\\tools\\run-simulation-debug.bat",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    }
  ]
}
