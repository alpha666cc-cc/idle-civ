{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Idle Civ: Start Vite",
      "type": "shell",
      "dependsOn": ["Idle Civ: Build"],
      "dependsOrder": "sequence",
      "command": "${workspaceFolder}\\tools\\node\\npm.cmd",
      "args": ["run", "dev", "--", "--host", "127.0.0.1"],
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": {
          "regexp": ".*"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "VITE",
          "endsPattern": "ready in"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false
      }
    },
    {
      "label": "Idle Civ: Build",
      "type": "shell",
      "command": "${workspaceFolder}\\tools\\node\\npm.cmd",
      "args": ["run", "build"],
      "problemMatcher": "$tsc",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
