{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Idle Civ: Run and Debug",
      "type": "pwa-chrome",
      "request": "launch",
      "url": "http://127.0.0.1:5173/",
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "Idle Civ: Start Dev Server",
      "postDebugTask": "Idle Civ: Stop Vite",
      "sourceMaps": true
    },
    {
      "name": "Idle Civ: Simulation Debug (Cheapest 4500s)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "${workspaceFolder}\\tools\\node\\node.exe",
      "runtimeArgs": ["--import", "tsx"],
      "program": "${workspaceFolder}\\tools\\run-simulation.mjs",
      "args": [
        "--strategy",
        "cheapest",
        "--objective",
        "timeLimit",
        "--target",
        "4500",
        "--verbose"
      ],
      "cwd": "${workspaceFolder}",
      "console": "internalConsole",
      "sourceMaps": true,
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
