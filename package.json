{
  "name": "idle-civilization",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "test:cross-language": "python tools/tests/offline_gain_test.py",
    "test:watch": "vitest",
    "preview": "vite preview",
    "simulate:battle": "node --experimental-strip-types temp/min-army.mjs",
    "helper:battle": "node helper/serve-battle-simulator.mjs",
    "simulate": "tsx tools/run-simulation.mjs",
    "simulate:compare": "tsx tools/compare-strategies.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}

